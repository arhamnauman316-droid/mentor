# Never put real keys in this file. Copy these names into Vercel Environment Variables.
OPENROUTER_API_KEY=

# Optional distributed rate limiting. Set BOTH variables if using Upstash Redis REST.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Recommended: set a long, random value in Vercel. Do not commit the real value.
RATE_LIMIT_SALT=
